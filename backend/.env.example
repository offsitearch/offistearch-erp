# =====================================================================
#  studioerp-v2 Local Docker Dev
# =====================================================================
# Copy this file to `.env` and fill in values. The stack auto-creates the
# schema + first superuser on startup (scripts/bootstrap.py), and the backend
# is served on port 8100 (postgres on 5433) so it runs alongside the old
# project (which uses 8000 / 5432).

# ---- Postgres (docker compose `db` service) --------------------------
# compose overrides DATABASE_URL automatically for the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studioerp_v2
POSTGRES_PORT=5433

# ---- Backend ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
# Strong random key — change this. 64+ hex chars recommended.
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_HEX_CHARS

# Backend port exposed on the host (default 8100).
BACKEND_PORT=8100

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8100

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Frontend (vite dev server, default 5173) ------------------------
FRONTEND_PORT=5173

# ---- First superadmin (created on startup if no users exist) ----------
# IMPORTANT: the stack shares ONE Supabase DB across environments. Set the
# SAME FIRST_SUPERUSER_EMAIL in every environment (local .env, Render, etc.)
# or a second superuser account gets created. Bootstrap is idempotent: if an
# account with this email already exists in the shared DB, it is NOT re-created.
FIRST_SUPERUSER_EMAIL=operation@offsitearch.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- SMTP (optional, leave disabled for local dev) --------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@studioerp.dev
SMTP_TIMEOUT_SECONDS=30

# ---- Google Drive backup (optional until configured) ------------------
# Redirect URI must match a registered OAuth client exactly. Port is 8100 here.
GOOGLE_REDIRECT_URI=http://localhost:8100/api/v1/backup/google/callback
BACKUP_UI_REDIRECT=http://localhost:5173/settings?tab=backup