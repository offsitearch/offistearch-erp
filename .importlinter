# Ring dependency contracts for the kernel+rings rebuild.
# Enforcement: `lint-imports` (import-linter v2). Outer rings may import inner
# rings; kernel imports ONLY stdlib + third-party (no app-internal imports).
#
# Contracts are added per-ring as each ring lands (Phases 5-9). As of Phase 7
# the live rings are:
#   k0 kernel  -> top-level studioerp.* modules (no inner imports)
#   k1 platform-> studioerp.platform.* (may import kernel only)
#   r2 people  -> studioerp.rings.people.* (may import kernel + platform)
#   r3 work    -> studioerp.rings.work.* (may import kernel + platform + people)
#   api root   -> studioerp.api (composition root, may import every ring)

[importlinter]
root_package = studioerp

# ── k0 kernel: no app-internal imports ─────────────────────────────────────
[importlinter:contract:1-kernel-no-inner-imports]
name = Kernel depends on no inner ring or composition root
type = forbidden
source_modules =
    studioerp.config
    studioerp.security
    studioerp.time
    studioerp.money
    studioerp.currency
    studioerp.errors
    studioerp.enums
    studioerp.state_machines
    studioerp.rbac
    studioerp.pdf_constants
    studioerp.db
    studioerp.request_context
    studioerp.logging_config
    studioerp.schemas
    studioerp.middleware
    studioerp.audit
forbidden_modules =
    studioerp.platform
    studioerp.rings
    studioerp.api

# ── k1 platform: may depend on kernel only (never outer rings or api root) ─
[importlinter:contract:2-platform-layer]
name = Platform ring depends only on the kernel
type = forbidden
source_modules =
    studioerp.platform
forbidden_modules =
    studioerp.api
    studioerp.rings

# ── r2 people: may depend on kernel + platform, never api root or sibling rings
[importlinter:contract:3-people-layer]
name = People ring depends only on kernel and platform
type = forbidden
source_modules =
    studioerp.rings.people
forbidden_modules =
    studioerp.api
    studioerp.rings.work
    studioerp.rings.money
    studioerp.rings.intelligence

# ── r3 work: may depend on kernel + platform + people, never api root or
#    outer (money / intelligence) sibling rings
[importlinter:contract:4-work-layer]
name = Work ring depends only on kernel, platform and people
type = forbidden
source_modules =
    studioerp.rings.work
forbidden_modules =
    studioerp.api
    studioerp.rings.money
    studioerp.rings.intelligence

