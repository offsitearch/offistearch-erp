# ── Local dev (leave unset — vite proxy forwards /api → localhost:8000) ──
# VITE_API_BASE_URL=/api/v1

# ── Production (Vercel) ─────────────────────────────────────────────────
# Set this in Vercel → Project → Settings → Environment Variables.
# Point it at your Render backend service URL:
# VITE_API_BASE_URL=https://studio-erp-api.onrender.com/api/v1

VITE_APP_NAME=StudioERP
